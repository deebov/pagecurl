{
  "name": "@pagecurl/react-native",
  "version": "0.1.0",
  "description": "A realistic page curl for React Native. Turn any views like the pages of a book. Drawn with Skia.",
  "keywords": [
    "react-native",
    "page curl",
    "page flip",
    "flipbook",
    "book",
    "skia",
    "animation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2",
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@pagecurl/core": "workspace:*",
    "@shopify/react-native-skia": "2.14.0",
    "react-native": "0.88.1"
  }
}
