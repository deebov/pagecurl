{
  "name": "@pagecurl/react",
  "version": "0.1.0",
  "description": "A realistic page curl for React. Turn any content like the pages of a book. Zero dependencies.",
  "keywords": [
    "react",
    "page curl",
    "page flip",
    "flipbook",
    "book",
    "webgl",
    "animation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@pagecurl/core": "workspace:*"
  }
}
