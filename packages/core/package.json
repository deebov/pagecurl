{
  "name": "@pagecurl/core",
  "version": "0.1.0",
  "description": "A realistic page curl for any DOM content. WebGL, zero dependencies, framework agnostic.",
  "keywords": [
    "page curl",
    "page flip",
    "flipbook",
    "book",
    "webgl",
    "animation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
